# Pure production regex contract. The portable runner expands the case table.
编译器 取 外言 '../src/regex_compile.ru'.
虚机 取 外言 '../src/regex_vm.ru'.
次数 取 [0].
作 确认 条件 为 事实 名 为 句:
    若 非 条件 则 卒 ('FAIL: '+名). 然
    次数[0] 取 次数[0]+1.
    显 'PASS: '+名.
为
# Row: name, pattern, scopeStart, scopeEnd, docLength, feeds, stepBudget,
# totalBudget, expectedStatus, expectedStart, expectedEnd.
算 运行 项:
    程序 取 编译器 其 编译 项[1].
    若 项[8] == 'compile-error' 则
        正确 取 程序['status'] == 'error'.
        若 (项 其 量) > 11 则 正确 取 正确 且 程序['code'] == 项[11]. 然
        确认 正确 项[0]. 得 空.
    然
    若 项[8] == 'compile-ok' 则
        确认 (程序['status'] == 'ok') 项[0]. 得 空.
    然
    若 程序['status'] != 'ok' 则 卒 ('FAIL: '+项[0]+' compile '+(程序['error'] 为 句)). 然
    若 项[8] == 'error' 且 (项 其 量) > 12 则 程序 其 增 项[11] 项[12]. 然
    状态 取 虚机 其 新建 程序 项[2] 项[3] 项[4] 项[7].
    喂位 取 0. 合规 取 真.
    循 200000 次
        若 状态['status'] == 'need-input' 则
            若 喂位 >= (项[5] 其 量) 则 卒 ('FAIL: '+项[0]+' unexpected input request'). 然
            块 取 项[5][喂位].
            虚机 其 喂入 状态 块[0] 块[1] 块[2] 块[3] 块[4].
            喂位 取 喂位+1.
        然
        若 状态['status'] == 'running' 则
            前功 取 状态['operations'].
            虚机 其 步进 状态 项[6].
            若 状态['lastOperations'] < 0 或 状态['lastOperations'] > 项[6] 或 状态['operations']-前功 != 状态['lastOperations'] 则 合规 取 假. 然
        然
        若 状态['status'] != 'running' 且 状态['status'] != 'need-input' 则
            确认 (合规 且 状态['status'] == 项[8] 且 状态['start'] == 项[9] 且 状态['end'] == 项[10]) 项[0].
            显 'RESULT '+项[0]+' '+状态['status']+' '+(状态['start'] 为 句)+' '+(状态['end'] 为 句)+' '+(状态['operations'] 为 句)+' '+(状态['readCursor'] 为 句).
            得 空.
        然
    环
    卒 ('FAIL: '+项[0]+' resumability watchdog').
法
# BEGIN CASES
